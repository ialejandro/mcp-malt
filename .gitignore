# Dependencies
node_modules/

# Build output. Published to npm from CI, never committed.
dist/
*.tsbuildinfo

# Test output
coverage/
.vitest/

# Credentials. MALT_API_TOKEN belongs in the environment, never in the repo.
.env
.env.*
!.env.example
*.pem
*.key

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# Local Claude Code settings. .claude/settings.json is shared; the .local one
# holds per-machine permissions and should not be.
.claude/settings.local.json

# Editors
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db
